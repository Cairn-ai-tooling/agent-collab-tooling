{
  // Markdown lint rules for this repo. Rationale lives in docs/decisions/0001-*.md.
  "config": {
    "default": true,
    // Prose is wrapped ~100 cols, but tables, code blocks and links legitimately exceed it.
    "MD013": false,
    // Keep a Changelog repeats "### Added" etc. under each version; only forbid duplicate
    // headings that share the same parent.
    "MD024": { "siblings_only": true },
    // SKILL.md files open with YAML frontmatter; don't require an H1 on line 1.
    "MD041": false
  },
  "ignores": [
    "node_modules",
    "LICENSE",
    // Scaffold templates are intentionally full of `<placeholder>` tokens and
    // example fenced blocks; the product-item Python scaffolder fills them by
    // exact-string replacement, so they can't be rewritten to satisfy MD033
    // (inline HTML) / MD025 (single H1) without breaking substitution. They are
    // data, not prose — lint the filled artifacts instead.
    "skills/product-item/assets/templates/*.md",
    "skills/product-item/assets/roadmap-template.md"
  ]
}
